# Let Google Meet PIP view popup, but not steal focus
# retry https://gist.github.com/ackerleytng/c0885034b3db9607c87b908a47348d7b
# https://groups.google.com/a/google.com/g/sway-users/c/jPn5qHYMdQA/m/x29mwxIcAQAJ
# ^^ botht didn't work
for_window [title="^Meet - (?!.* - Google Chrome$).*$" app_id="google-chrome"] {
    floating enable
    resize set width 20ppt height 20ppt
    move position 80ppt 80ppt
    sticky enable
}
# ---------------------------------------------------------
# FAILSAFE: PROTECT MAIN CHROME WINDOWS
# ---------------------------------------------------------
# This acts as a final override. Even if an earlier rule 
# (like the pop-up or Meet rules) accidentally targets the main 
# browser window, this will force it back into a tiled state.
for_window [app_id="google-chrome" title=".* - Google Chrome$"] floating disable

# Include Google-specific Sway configuration (silently ignored on non-Google machines)
