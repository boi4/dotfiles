# Variables 
set $TERMINAL kitty

set $mod Mod4
set $up k
set $down j
set $left h
set $right l

set $Menu1 j4-dmenu-desktop --dmenu='rofi -i -dmenu' # -font "Helvetica Neue 15" '
set $Menu2 dmenu_path | dmenu | xargs swaymsg exec -- 
#set $Menu3 rofi -theme Arc-Dark -combi-modi window#drun -show combi -modi combi -show-icons
#set $Menu3 rofi -monitor -1 -theme Arc-Dark -combi-modi window#drun -show combi -modi combi -show-icons
#set $Menu3 rofi -monitor $(swaymsg -t get_outputs | jq '[.[].focused] | index(true)') -theme Arc-Dark -combi-modi window#drun -show combi -modi combi -show-icons
set $Menu3 rofi -monitor $(swaymsg -t get_outputs | jq -r '.[] | select(.focused) | .name') -theme Arc-Dark -combi-modi window#drun -show combi -modi combi -show-icons

#output HDMI-A-1 scale 2


# general settings
xwayland enable
floating_modifier $mod normal
default_orientation auto
popup_during_fullscreen smart
smart_borders on

font pango:DejaVu Sans Mono 10

# Input Settings
#input 1133:50484:Logitech_USB_Receiver repeat_rate 70
# see man 5 sway-input
input * {
  repeat_delay 180
  repeat_rate 70
  xkb_layout "eu"
  xkb_options "caps:escape"
}
input type:touchpad natural_scroll disabled



# gaps settings
gaps inner 0
default_border pixel 2
gaps outer 0
smart_gaps on


# background
#output * bg ~/.config/sway/wallpaper.png fill
#~/.config/sway/wallpaper.png
output * bg ~/.config/sway/wallpaper.png fill


# ---------------------------------------------------------
# IDLE CONFIGURATION (swayidle)
# ---------------------------------------------------------
exec swayidle -w \
    timeout 300 'swaylock -f -i ~/.config/sway/wallpaper.png' \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f -i ~/.config/sway/wallpaper.png'
    #timeout 6000 'systemctl suspend' \




